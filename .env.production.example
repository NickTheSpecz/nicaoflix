# NicãoFlix Production Environment Variables
# Configure these in Vercel Dashboard under Project Settings > Environment Variables

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://superflixapi.run

# Site Configuration (Update with your actual Vercel domain)
NEXT_PUBLIC_SITE_URL=https://nicaoflix.vercel.app
NEXT_PUBLIC_SITE_NAME=NicãoFlix

# Feature Flags
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true
NEXT_PUBLIC_ENABLE_SYNC=true
NEXT_PUBLIC_SYNC_INTERVAL=3600000

# Performance
NEXT_PUBLIC_IMAGE_QUALITY=85
NEXT_PUBLIC_PREFETCH_ENABLED=true

# Production
NODE_ENV=production
